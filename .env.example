# Supabase Postgres
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Football data: "espn" (default, no key, includes player stats) or "football-data" (official backup, fixtures only)
FIXTURES_PROVIDER="espn"
FOOTBALL_DATA_API_KEY=""

# AI worker (Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Queue a match summary automatically when a match's stats arrive ("false" to turn off)
AI_AUTO_SUMMARIES="true"

# Public address of the site (used for share images). Change when the site goes online.
SITE_URL="http://localhost:3000"

# Protects /api/cron/* routes
CRON_SECRET=""
