# Supabase Postgres
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Football data: "espn" (default, no key, includes player stats) or "football-data" (official backup, fixtures only)
FIXTURES_PROVIDER="espn"
FOOTBALL_DATA_API_KEY=""

# AI worker (Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Queue a match summary automatically when a match's stats arrive ("false" to turn off)
AI_AUTO_SUMMARIES="true"
# Most Rex may spend in 24 hours, in US dollars (default 1, about RM4.70). Jobs wait in the queue once reached.
AI_DAILY_BUDGET_USD="1"

# Optional: Telegram alerts when a sync or Rex job fails, or the AI budget is reached.
# Create a bot with @BotFather for the token; the chat id is your own Telegram user id (ask @userinfobot).
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""

# Optional: shown on the privacy page for data requests
SITE_CONTACT_EMAIL=""

# Public address of the site (used for share images). Change when the site goes online.
SITE_URL="http://localhost:3000"

# Protects /api/cron/* routes
CRON_SECRET=""
